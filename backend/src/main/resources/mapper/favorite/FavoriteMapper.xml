<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.m998.civilservice.modules.favorite.mapper.FavoriteMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.m998.civilservice.modules.favorite.model.Favorite">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="position_id" property="positionId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <!-- 收藏DTO结果映射 -->
    <resultMap id="FavoriteDtoMap" type="com.m998.civilservice.modules.favorite.dto.FavoriteDto">
        <id column="id" property="id" />
        <result column="position_id" property="positionId" />
        <result column="position_name" property="positionName" />
        <result column="department" property="department" />
        <result column="year" property="year" />
        <result column="create_time" property="favoriteTime" />
        <result column="education_required" property="educationRequired" />
        <result column="major_required" property="majorRequired" />
        <result column="recruitment_number" property="recruitmentNumber" />
    </resultMap>

    <!-- 获取用户的收藏列表（关联岗位信息） -->
    <select id="selectFavoriteListByUserId" resultMap="FavoriteDtoMap">
        SELECT
            f.id,
            f.position_id,
            p.position_name,
            p.department,
            p.year,
            f.create_time,
            p.education_required,
            p.major_required,
            p.recruitment_number
        FROM favorite f
        INNER JOIN position p ON f.position_id = p.id
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

    <!-- 分页获取用户的收藏列表（关联岗位信息） -->
    <select id="selectFavoritePageByUserId" resultMap="FavoriteDtoMap">
        SELECT
            f.id,
            f.position_id,
            p.position_name,
            p.department,
            p.year,
            f.create_time,
            p.education_required,
            p.major_required,
            p.recruitment_number
        FROM favorite f
        INNER JOIN position p ON f.position_id = p.id
        WHERE f.user_id = #{userId}
        ORDER BY f.create_time DESC
    </select>

</mapper>
